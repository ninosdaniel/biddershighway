new file mode 100644
index 0000000..fdbdd3d
--- /dev/null
+++ b/supabase/migrations/20261015000100_seller_commission_minimum.sql
@@ -0,0 +1,20 @@
+-- Source: biddershighway/highway main @ 0bae38c, app/services/sold_state.rb.
+-- Apply prospectively; do not recalculate historical sales or invoices.
+BEGIN;
+CREATE OR REPLACE FUNCTION app_private.settle_sale(p_auction_id uuid,p_buyer_id uuid,p_amount integer,p_sale_type text) RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+DECLARE a public.auctions; buyer_vat numeric; seller_vat numeric;
+BEGIN
+ SELECT * INTO STRICT a FROM public.auctions WHERE id=p_auction_id FOR UPDATE;
+ IF a.lifecycle_status IN (9,10) THEN RAISE EXCEPTION 'already_concluded'; END IF;
+ IF p_amount IS NULL OR p_amount<=0 OR p_buyer_id IS NULL OR p_buyer_id=a.seller_id THEN RAISE EXCEPTION 'invalid_sale'; END IF;
+ SELECT CASE WHEN customer_type=2 THEN 1 ELSE 1.25 END INTO buyer_vat FROM public.users WHERE id=p_buyer_id;
+ SELECT CASE WHEN customer_type=2 THEN 1 ELSE 1.25 END INTO seller_vat FROM public.users WHERE id=a.seller_id;
+ UPDATE public.auctions SET buyer_id=p_buyer_id,sale_price_cents=p_amount,sale_price_currency='SEK',lifecycle_status=9,sale_type=p_sale_type,
+   commission_cents=least(greatest(round(p_amount*a.commission_buyer_percent::numeric*0.8/100),400000),6000000),commission_currency='SEK',commission_vat=coalesce(buyer_vat,1.25),
+   commission_seller_cents=CASE WHEN a.commission_seller_percent=0 THEN 0 ELSE greatest(round(p_amount*a.commission_seller_percent::numeric*0.8/100),200000) END,commission_seller_currency='SEK',commission_seller_vat=coalesce(seller_vat,1.25),
+   reserve_shortfall_cents=greatest(coalesce(a.reserve_price_cents,0)-p_amount,0),updated_at=now() WHERE id=a.id;
+ PERFORM app_private.emit('auction.sold',a.id,jsonb_build_object('buyer_id',p_buyer_id),'sold:'||a.id::text||':'||a.sequence_number::text);
+ -- Invoice creation, bookkeeping and communication are separate idempotent jobs.
+ -- paid stays false until a provider-confirmed settlement is recorded.
+END $$;
+COMMIT;
