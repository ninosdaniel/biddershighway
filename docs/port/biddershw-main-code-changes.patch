+++ b/scripts/compare-highway.mjs
@@ -0,0 +1,60 @@
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+const source = process.argv[2];
+if (!source) throw new Error("Usage: node scripts/compare-highway.mjs /path/to/fresh/highway-clone");
+const sourceCommit = "0bae38c04fb0e6c9510d7bba659c151f456c095d";
+const targetCommit = "303d0572e3357e69171cda5b6e280d93e7712c7b";
+const git = (cwd, ...args) => execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8", maxBuffer: 20_000_000 }).trimEnd();
+const identity = (url) => url.replace(/^git@github.com:/, "https://github.com/").replace(/\.git$/, "").toLowerCase();
+if (identity(git(source, "remote", "get-url", "origin")) !== "https://github.com/biddershighway/highway" || git(source, "rev-parse", "HEAD") !== sourceCommit) throw new Error("Wrong source repository or commit; review and repin the comparison first.");
+if (identity(git(process.cwd(), "remote", "get-url", "origin")) !== "https://github.com/biddershw/biddershighway" || git(process.cwd(), "rev-parse", "HEAD") !== targetCommit) throw new Error("Wrong target repository or commit; review and repin the comparison first.");
+
+const folders = ["app/controllers", "app/jobs", "app/models", "app/policies", "app/services", "app/mailers", "app/views", "app/pdfs", "app/javascript", "config", "lib/tasks"];
+const tree = git(source, "ls-tree", "-r", "HEAD").split("\n").map(line => {
+  const [entry, filename] = line.split("\t");
+  return { filename, blob: entry.split(" ")[2] };
+});
+const units = tree.filter(({ filename }) => folders.some(folder => filename.startsWith(`${folder}/`)) && /\.(rb|js|yml|yaml|rake|cr)$/.test(filename)).map(({ filename, blob }) => {
+  const bytes = readFileSync(path.join(source, filename));
+  const actualBlob = createHash("sha1").update(`blob ${bytes.length}\0`).update(bytes).digest("hex");
+  if (actualBlob !== blob) throw new Error(`Source working file differs from pinned GitHub commit: ${filename}`);
+  const content = bytes.toString("utf8");
+  return {
+    path: filename, git_blob: blob, sha256: createHash("sha256").update(bytes).digest("hex"),
+    methods: [...content.matchAll(/^[ \t]*def[ \t]+([^\s(;]+)/gm)].map(match => ({ name: match[1], line: content.slice(0, match.index).split("\n").length })),
+    github_url: `https://github.com/biddershighway/highway/blob/${sourceCommit}/${filename}`,
+    status: "not_verified",
+  };
+});
+const inventory = {
+  source: { repository: "biddershighway/highway", branch: "main", commit: sourceCommit },
+  target: { repository: "BiddersHW/biddershighway", branch: "main", commit: targetCommit },
+  date: "2026-10-15",
+  counts: Object.fromEntries(folders.map(folder => [folder, units.filter(unit => unit.path.startsWith(`${folder}/`)).length])),
+  method_count: units.reduce((count, unit) => count + unit.methods.length, 0),
+  notes: [
+    "Tracked source files verified against Git blobs from the pinned GitHub commit. Method extraction is lexical, not runtime Rails route expansion; inherited actions, callbacks and templates need behavior review.",
+    "not_verified is not an implementation claim. See workflow-coverage.json for the reviewed controller/job mapping and MAIN-COMPARISON.md for confirmed gaps.",
+  ],
+  units,
+};
+writeFileSync("docs/port/main-comparison-inventory.json", JSON.stringify(inventory, null, 2) + "\n");
+const oldSchema = JSON.parse(git(process.cwd(), "show", `${targetCommit}:src/lib/port/rails-schema.json`));
+const currentSchema = JSON.parse(execFileSync("ruby", ["scripts/read-rails-schema.rb", path.join(source, "db/schema.rb")], { encoding: "utf8", maxBuffer: 10_000_000 }));
+const oldTables = new Map(oldSchema.tables.map(table => [table.name, table]));
+const changes = currentSchema.tables.flatMap(table => {
+  const original = oldTables.get(table.name);
+  if (!original) return [{ kind: "new_table", table: table.name, definition: table }];
+  const oldCols = new Map(original.columns.map(col => [col.name, col]));
+  const newCols = new Map(table.columns.map(col => [col.name, col]));
+  return [
+    ...table.columns.filter(col => !oldCols.has(col.name)).map(col => ({ kind: "add_column", table: table.name, column: col })),
+    ...table.columns.filter(col => oldCols.has(col.name) && JSON.stringify(col) !== JSON.stringify(oldCols.get(col.name))).map(col => ({ kind: "change_column", table: table.name, before: oldCols.get(col.name), after: col })),
+    ...original.columns.filter(col => !newCols.has(col.name)).map(col => ({ kind: "legacy_column_removed_in_source", table: table.name, column: col })),
+  ];
+});
+writeFileSync("docs/port/schema-diff.json", JSON.stringify({ source: inventory.source, target: inventory.target, source_tables: currentSchema.tables.length, target_tables: oldSchema.tables.length, changes, note: "Structural comparison, not a migration. Retained legacy columns need an explicit data/compatibility migration; do not drop populated columns mechanically." }, null, 2) + "\n");
+console.log(`Verified ${units.length} tracked source files, ${inventory.method_count} declared Ruby methods and ${changes.length} table/column differences.`);
