NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_LISTING_IMAGE_BASE_URL=https://bidders-highway.fra1.cdn.digitaloceanspaces.com/

# Editorial/informational pages use the local content import. Vehicle listings
# and auction details always read Supabase, with no original-site fallback.

# Controls account/form actions only; public database reads are always enabled.
# Enable after configuring and testing the backend and its providers.
NEXT_PUBLIC_WEBSITE_BACKEND_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The migration preview should not compete with the current production site.
SITE_INDEXABLE=false
