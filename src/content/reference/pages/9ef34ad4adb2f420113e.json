-90 transition-all\"><img src=\"https://bidders-highway.fra1.cdn.digitaloceanspaces.com/927ce417f8082df9b305c4c302ab321e\" loading=\"lazy\" class=\"w-full h-full object-cover rounded-lg hover:brightness-108 transition-all\" alt=\"1964 Honda CB92 RBC15A\" width=\"820\" height=\"560\"></a><h4 class=\"absolute bottom-0 left-0 mb-0 pb-2 h-1/2 text-sm w-full px-2 flex items-end pointer-events-none bg-gradient-to-t from-black/80\">1964 Honda CB92</h4></div></li><li class=\"w-1/2 lg:w-1/5 snap-start\"><div style=\"aspect-ratio: 82/56;\" class=\"relative\"><a href=\"/en/auctions/yamaha-as2c-blue\" class=\"hover:opacity-90 transition-all\"><img src=\"https://bidders-highway.fra1.cdn.digitaloceanspaces.com/aafee025d76278b803cac12bfb882349\" loading=\"lazy\" class=\"w-full h-full object-cover rounded-lg hover:brightness-108 transition-all\" alt=\"1970 Yamaha AS2C FZJ263\" width=\"820\" height=\"560\"></a><h4 class=\"absolute bottom-0 left-0 mb-0 pb-2 h-1/2 text-sm w-full px-2 flex items-end pointer-events-none bg-gradient-to-t from-black/80\">1970 Yamaha AS2C</h4></div></li><li class=\"w-1/2 lg:w-1/5 snap-start\"><div style=\"aspect-ratio: 82/56;\" class=\"relative\"><a href=\"/en/auctions/horex-regina-350\" class=\"hover:opacity-90 transition-all\"><img src=\"https://bidders-highway.fra1.cdn.digitaloceanspaces.com/3bf3490118d9b2a92f8a6058c3d38bb5\" loading=\"lazy\" class=\"w-full h-full object-cover rounded-lg hover:brightness-108 transition-all\" alt=\"1952 Horex Regina 350 Z-52 350\" width=\"820\" height=\"560\"></a><h4 class=\"absolute bottom-0 left-0 mb-0 pb-2 h-1/2 text-sm w-full px-2 flex items-end pointer-events-none bg-gradient-to-t from-black/80\">1952 Horex Regina 350</h4></div></li><li class=\"w-1/2 lg:w-1/5 snap-start\"><div style=\"aspect-ratio: 82/56;\" class=\"relative\"><a href=\"/en/auctions/honda-cb750-sandcast\" class=\"hover:opacity-90 transition-all\"><img src=\"https://bidders-highway.fra1.cdn.digitaloceanspaces.com/97335c7df38a043f6b5f6bcf7f6b54b1\" loa