  "mainHtml": "<main class=\"bg-white\"><article class=\"pb-12 md:pb-20\"><header class=\"bg-off-white\"><div class=\"container mx-auto px-4 py-12\"><h1 class=\"text-3xl lg:text-4xl xl:text-5xl mb-4\">Inhaltsseiten</h1><p class=\"text-neutral-600 text-lg\">Durchsuchen Sie unsere Sammlung von Informationsseiten und Leitfäden</p></div></header><div class=\"container mx-auto px-4 my-8 lg:my-12\"><div class=\"grid gap-8 md:grid-cols-2 lg:grid-cols-3\"><article class=\"border border-neutral-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow\"><a href=\"/de/pages/safety-and-security-at-bidders-highway\"><div class=\"aspect-video bg-neutral-100\"></div><div class=\"p-6\"><h3 class=\"text-xl font-semibold mb-2 hover:text-blue-600\">Sicherheit und Vertrauen bei Bidders Highway</h3><p class=\"text-neutral-600 mb-3 line-clamp-3\">Sichere, überwachte Auktionen mit verifizierten Bietern. Hunderte Fahrzeuge vermittelt. Verbindliche Bedingungen für Käufer und Verkäufer.</p><span class=\"text-sm text-neutral-500\">September 30, 2025 09:00</span></div></a></article><article class=\"border border-neutral-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow\"><a href=\"/de/pages/about-us\"><div class=\"aspect-video bg-neutral-100\"><img src=\"https://bidders-highway.fra1.cdn.digitaloceanspaces.com/82e8a589370c79c59f6c4fd9de820573\" alt=\"Über uns\" class=\"w-full h-full object-cover\"></div><div class=\"p-6\"><h3 class=\"text-xl font-semibold mb-2 hover:text-blue-600\">Über uns</h3><p class=\"text-neutral-600 mb-3 line-clamp-3\">Bidders Highway ist ein digitaler Marktplatz für Liebhaberfahrzeuge. Autos und Motorräder, die ihren Besitzern etwas Besonderes bedeuten.</p><span class=\"text-sm text-neutral-500\">September 22, 2025 09:00</span></div></a></article></div></div></article></main>",
