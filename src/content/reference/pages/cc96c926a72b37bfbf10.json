  "mainHtml": "<main class=\"bg-white\"><div class=\"bg-off-white py-12\"><div class=\"container mx-auto px-4 text-center\"><h1 class=\"text-3xl md:text-5xl mb-0\">Articles</h1><span class=\"text-neutral-400 block mt-4 max-w-4xl mx-auto\">Texts written by the Bidders Highway team.</span></div></div><div class=\"container mx-auto px-4 mb-8\"><nav class=\"flex flex-wrap gap-2 mt-8\"><a href=\"/en/posts\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-neutral-900 text-white border-neutral-900\">All</a><a href=\"/en/posts?tag=collections\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-stone-100 text-stone-700 border-stone-300 hover:bg-stone-200\">Collections</a><a href=\"/en/posts?tag=event\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100\">Event</a><a href=\"/en/posts?tag=jacobs_takes\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-sky-50 text-sky-800 border-sky-300 hover:bg-sky-100\">Jacob's takes</a><a href=\"/en/posts?tag=guides\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-emerald-50 text-emerald-800 border-emerald-300 hover:bg-emerald-100\">Guides</a><a href=\"/en/posts?tag=our_cars\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-rose-50 text-rose-800 border-rose-300 hover:bg-rose-100\">Our cars</a><a href=\"/en/posts?tag=featured_cars\" class=\"inline-flex items-center text-sm px-3 py-1.5 rounded-full border transition-colors bg-violet-50 text-violet-800 border-violet-300 hover:bg-violet-100\">Featured cars</a></nav><ul class=\"md:grid grid-cols-2 gap-4 gap-y-8 lg:grid-cols-3 xl:grid-cols-4 mb-8 mt-8 xl:grid-cols-3!\"><li class=\"post\"><a href=\"/en/posts/the-classic-volvo-collection-1\" class=\"transition-colors hover:t