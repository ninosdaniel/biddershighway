NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_LISTING_IMAGE_BASE_URL=https://bidders-highway.fra1.cdn.digitaloceanspaces.com/

# Articles, pages, authors and vehicle records read Supabase directly.
# Remaining informational content (such as FAQ) uses the local import.

# Controls account/form actions only; public database reads are always enabled.
# Enable after configuring and testing the backend and its providers.
NEXT_PUBLIC_WEBSITE_BACKEND_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The migration preview should not compete with the current production site.
SITE_INDEXABLE=false

# Optional server-only connection for the original public catalog/detail fields.
# Every query runs inside an explicit READ ONLY transaction with verified TLS.
# Never use a NEXT_PUBLIC_ prefix for this value. Live editorial also requires
# migration 021; the original catalog/detail queries need no added RPC.
WEBSITE_DATABASE_READ_URL=
