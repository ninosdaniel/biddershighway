    "next": "^16.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
